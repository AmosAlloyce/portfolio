<div class="container mx-auto px-4 py-8">
  <%= link_to "← Back to Portfolio", repositories_path, class: "text-blue-500 mb-4 inline-block" %>
  
  <div class="bg-white rounded-lg shadow-md p-8">
    <h1 class="text-4xl font-bold mb-4"><%= @repository.name %></h1>
    <p class="text-xl text-gray-600 mb-6"><%= @repository.description %></p>
    
    <div class="flex items-center gap-6 mb-6">
      <span class="text-lg"><strong>Language:</strong> <%= @repository.language %></span>
      <span class="text-lg">⭐ <%= @repository.stargazers_count %> stars</span>
      <span class="text-lg">🍴 <%= @repository.forks_count %> forks</span>
      <% if @repository.has_docker %>
        <span class="text-lg">🐳 Docker Ready</span>
      <% end %>
    </div>
    
    <div class="flex gap-4 mb-8">
      <%= link_to "View on GitHub", @repository.html_url, target: "_blank", class: "bg-gray-800 text-white px-6 py-3 rounded-lg" %>
      <% if @repository.has_docker %>
        <%= link_to "🐳 Launch in Play-with-Docker", @repository.pwd_launch_url, target: "_blank", class: "bg-blue-500 text-white px-6 py-3 rounded-lg" %>
      <% end %>
      <% if @repository.homepage.present? %>
        <%= link_to "Live Demo", @repository.homepage, target: "_blank", class: "bg-green-500 text-white px-6 py-3 rounded-lg" %>
      <% end %>
    </div>
    
    <% if @repository.topics_array.any? %>
      <div class="mb-6">
        <h3 class="text-xl font-bold mb-2">Topics</h3>
        <div class="flex flex-wrap gap-2">
          <% @repository.topics_array.each do |topic| %>
            <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm">#<%= topic %></span>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <% if @repository.readme_content.present? %>
      <div class="mt-8">
        <h3 class="text-2xl font-bold mb-4">README Preview</h3>
        <div class="prose max-w-none">
          <%= simple_format(@repository.readme_content.truncate(1000)) %>
        </div>
        <%= link_to "Read full README on GitHub →", @repository.html_url, target: "_blank", class: "text-blue-500 mt-4 inline-block" %>
      </div>
    <% end %>
  </div>
  
  <% if @related_repositories.any? %>
    <div class="mt-8">
      <h2 class="text-2xl font-bold mb-4">Related Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @related_repositories.each do |repo| %>
          <div class="bg-white rounded-lg shadow-md p-4">
            <h3 class="text-xl font-bold mb-2"><%= repo.name %></h3>
            <p class="text-gray-600 text-sm mb-2"><%= repo.description&.truncate(100) %></p>
            <%= link_to "View →", repository_path(repo), class: "text-blue-500" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
